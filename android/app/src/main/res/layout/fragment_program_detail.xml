<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_program_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30-Day Lean Muscle Challenge"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_program_creator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="By Fitness Pro • ⭐ 4.9 (142 reviews)"
            android:textColor="@color/secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_program_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="A high-intensity hypertrophy and strength regimen designed to pack on lean muscle in 4 weeks."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- One-Tap Follow Button (Core Feature) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_follow_program"
            style="@style/BodyPilotButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="✨ Follow Program with 1-Tap" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Program Schedule Preview"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_program_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>
