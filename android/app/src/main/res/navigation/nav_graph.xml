<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.bodypilot.app.ui.auth.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_onboarding"
            app:destination="@id/onboardingFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_dashboard"
            app:destination="@id/nav_dashboard"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.bodypilot.app.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_forgotPassword"
            app:destination="@id/forgotPasswordFragment" />
        <action
            android:id="@+id/action_login_to_onboarding"
            app:destination="@id/onboardingFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_dashboard"
            app:destination="@id/nav_dashboard"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.bodypilot.app.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_register_to_onboarding"
            app:destination="@id/onboardingFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.bodypilot.app.ui.auth.ForgotPasswordFragment"
        android:label="Forgot Password"
        tools:layout="@layout/fragment_forgot_password" />

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.bodypilot.app.ui.onboarding.OnboardingFragment"
        android:label="Assessment"
        tools:layout="@layout/fragment_onboarding">
        <action
            android:id="@+id/action_onboarding_to_dashboard"
            app:destination="@id/nav_dashboard"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Bottom Nav Destinations -->
    <fragment
        android:id="@+id/nav_dashboard"
        android:name="com.bodypilot.app.ui.dashboard.DashboardFragment"
        android:label="Today"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboard_to_activeWorkout"
            app:destination="@id/activeWorkoutFragment" />
        <action
            android:id="@+id/action_dashboard_to_workoutPlan"
            app:destination="@id/nav_workout" />
        <action
            android:id="@+id/action_dashboard_to_mealPlan"
            app:destination="@id/nav_nutrition" />
        <action
            android:id="@+id/action_dashboard_to_foodLog"
            app:destination="@id/foodLogFragment" />
        <action
            android:id="@+id/action_dashboard_to_community"
            app:destination="@id/communityFeedFragment" />
        <action
            android:id="@+id/action_dashboard_to_creators"
            app:destination="@id/creatorBrowseFragment" />
        <action
            android:id="@+id/action_dashboard_to_settings"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_dashboard_to_admin"
            app:destination="@id/adminDashboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/nav_workout"
        android:name="com.bodypilot.app.ui.workout.WorkoutPlanFragment"
        android:label="Workouts"
        tools:layout="@layout/fragment_workout_plan">
        <action
            android:id="@+id/action_workout_to_active"
            app:destination="@id/activeWorkoutFragment" />
        <action
            android:id="@+id/action_workout_to_library"
            app:destination="@id/exerciseLibraryFragment" />
    </fragment>

    <fragment
        android:id="@+id/activeWorkoutFragment"
        android:name="com.bodypilot.app.ui.workout.ActiveWorkoutFragment"
        android:label="Active Workout"
        tools:layout="@layout/fragment_active_workout">
        <action
            android:id="@+id/action_active_to_feedback"
            app:destination="@id/postWorkoutFeedbackFragment"
            app:popUpTo="@id/nav_workout" />
    </fragment>

    <fragment
        android:id="@+id/postWorkoutFeedbackFragment"
        android:name="com.bodypilot.app.ui.workout.PostWorkoutFeedbackFragment"
        android:label="Feedback"
        tools:layout="@layout/fragment_post_workout_feedback" />

    <fragment
        android:id="@+id/exerciseLibraryFragment"
        android:name="com.bodypilot.app.ui.workout.ExerciseLibraryFragment"
        android:label="Exercise Library"
        tools:layout="@layout/fragment_exercise_library">
        <action
            android:id="@+id/action_library_to_detail"
            app:destination="@id/exerciseDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/exerciseDetailFragment"
        android:name="com.bodypilot.app.ui.workout.ExerciseDetailFragment"
        android:label="Exercise Detail"
        tools:layout="@layout/fragment_exercise_detail" />

    <fragment
        android:id="@+id/nav_nutrition"
        android:name="com.bodypilot.app.ui.nutrition.MealPlanFragment"
        android:label="Nutrition"
        tools:layout="@layout/fragment_meal_plan">
        <action
            android:id="@+id/action_nutrition_to_foodLog"
            app:destination="@id/foodLogFragment" />
        <action
            android:id="@+id/action_nutrition_to_substitution"
            app:destination="@id/foodSubstitutionFragment" />
        <action
            android:id="@+id/action_nutrition_to_recipes"
            app:destination="@id/recipeListFragment" />
        <action
            android:id="@+id/action_nutrition_to_shoppingList"
            app:destination="@id/shoppingListFragment" />
    </fragment>

    <fragment
        android:id="@+id/foodLogFragment"
        android:name="com.bodypilot.app.ui.nutrition.FoodLogFragment"
        android:label="Log Food"
        tools:layout="@layout/fragment_food_log" />

    <fragment
        android:id="@+id/foodSubstitutionFragment"
        android:name="com.bodypilot.app.ui.nutrition.FoodSubstitutionFragment"
        android:label="Substitute Food"
        tools:layout="@layout/fragment_food_substitution" />

    <fragment
        android:id="@+id/recipeListFragment"
        android:name="com.bodypilot.app.ui.nutrition.RecipeListFragment"
        android:label="Recipes"
        tools:layout="@layout/fragment_recipe_list">
        <action
            android:id="@+id/action_recipes_to_detail"
            app:destination="@id/recipeDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/recipeDetailFragment"
        android:name="com.bodypilot.app.ui.nutrition.RecipeDetailFragment"
        android:label="Recipe"
        tools:layout="@layout/fragment_recipe_detail" />

    <fragment
        android:id="@+id/shoppingListFragment"
        android:name="com.bodypilot.app.ui.nutrition.ShoppingListFragment"
        android:label="Grocery List"
        tools:layout="@layout/fragment_shopping_list" />

    <fragment
        android:id="@+id/nav_progress"
        android:name="com.bodypilot.app.ui.progress.ProgressFragment"
        android:label="Progress"
        tools:layout="@layout/fragment_progress">
        <action
            android:id="@+id/action_progress_to_goals"
            app:destination="@id/goalsFragment" />
    </fragment>

    <fragment
        android:id="@+id/goalsFragment"
        android:name="com.bodypilot.app.ui.progress.GoalsFragment"
        android:label="Goals &amp; Milestones"
        tools:layout="@layout/fragment_goals" />

    <fragment
        android:id="@+id/nav_assistant"
        android:name="com.bodypilot.app.ui.assistant.AssistantFragment"
        android:label="AI Coach"
        tools:layout="@layout/fragment_assistant" />

    <fragment
        android:id="@+id/creatorBrowseFragment"
        android:name="com.bodypilot.app.ui.creator.CreatorBrowseFragment"
        android:label="Creators"
        tools:layout="@layout/fragment_creator_browse">
        <action
            android:id="@+id/action_creators_to_profile"
            app:destination="@id/creatorProfileFragment" />
        <action
            android:id="@+id/action_creators_to_program"
            app:destination="@id/programDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/creatorProfileFragment"
        android:name="com.bodypilot.app.ui.creator.CreatorProfileFragment"
        android:label="Creator Profile"
        tools:layout="@layout/fragment_creator_profile" />

    <fragment
        android:id="@+id/programDetailFragment"
        android:name="com.bodypilot.app.ui.creator.ProgramDetailFragment"
        android:label="Program Details"
        tools:layout="@layout/fragment_program_detail" />

    <fragment
        android:id="@+id/communityFeedFragment"
        android:name="com.bodypilot.app.ui.community.CommunityFeedFragment"
        android:label="Community"
        tools:layout="@layout/fragment_community_feed">
        <action
            android:id="@+id/action_community_to_challenges"
            app:destination="@id/challengesFragment" />
    </fragment>

    <fragment
        android:id="@+id/challengesFragment"
        android:name="com.bodypilot.app.ui.community.ChallengesFragment"
        android:label="Challenges"
        tools:layout="@layout/fragment_challenges" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.bodypilot.app.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settings_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/adminDashboardFragment"
        android:name="com.bodypilot.app.ui.admin.AdminDashboardFragment"
        android:label="Admin Panel"
        tools:layout="@layout/fragment_admin_dashboard" />

</navigation>
